{
  "name": "quiz-games",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "analyze": "ANALYZE=true bun run build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config db-tests/vitest.config.ts",
    "test:menu": "bun scripts/test-runner.ts",
    "test:ci": "vitest run --reporter=verbose --reporter=junit --outputFile=test-results/junit.xml",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:report": "playwright show-report",
    "test:e2e:quiz": "playwright test -c playwright.stack.config.ts",
    "e2e:stack": "node e2e/stack/stack.mjs",
    "test:all": "bun run test:ci && bun run test:e2e",
    "cleanup:orphaned": "bun scripts/cleanup-orphaned-records.ts",
    "smoke:prod": "bun load-test/smoke.ts --base https://1think2win.com",
    "cache:check": "bun load-test/page-cache.ts --base https://1think2win.com",
    "cache:purge": "bun --env-file=.env.cloudflare load-test/page-cache.ts --base https://1think2win.com --purge",
    "graphify:update": "GEMINI_API_KEY=$Graphify_GEMINI_API_KEY GEMINI_MODEL='gemini-3.5-flash-lite' graphify update ."
  },
  "ignoredBuiltDependencies": [
    "esbuild"
  ],
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@sentry/nextjs": "11.8.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.117.3",
    "aws4fetch": "1.0.20",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.56.0",
    "next": "~16.4.3",
    "next-cloudinary": "^7.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.90.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "standardwebhooks": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@next/bundle-analyzer": "~16.4.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "~16.4.3",
    "jsdom": "22.1.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
