{
  "ref": "web_app_manifest",
  "description": "Web app manifest (/manifest.json): browsers fetch it on most page loads, cache for the time its Cache-Control allows (1 day)",
  "expression": "(http.host eq \"1think2win.com\" and http.request.uri.path eq \"/manifest.json\")",
  "action": "set_cache_settings",
  "action_parameters": {
    "cache": true,
    "edge_ttl": { "mode": "bypass_by_default" },
    "browser_ttl": { "mode": "respect_origin" }
  },
  "enabled": true
}
