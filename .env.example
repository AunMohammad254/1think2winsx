# ==================================================================================================
# 1Think 2Win - TEMPLATE for .env (local development) and .env.production (the live site)
# Copy it to .env, fill in the values, and keep the same sections. This template is committed:
# never put a real secret in it.
# ==================================================================================================

# --- SITE ------------------------------------------------------------------------------------------
# The address the site runs on: links in emails, sign-in redirects, cron calls.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SUPABASE (database and sign-in) ---------------------------------------------------------------
# Project eclivawqhdovsndlngfo, Mumbai. The service-role key can read and change everything: keep it secret.
# Google sign-in callback (set in the Supabase dashboard): https://eclivawqhdovsndlngfo.supabase.co/auth/v1/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# --- ADMIN AND SECURITY ----------------------------------------------------------------------------
# CRON_SECRET must match the ?secret= in the Hostinger cron URL for /api/cron/process-scheduled.
# NEWSLETTER_UNSUBSCRIBE_SECRET signs unsubscribe links: it must be the same everywhere.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is the public Cloudflare Turnstile key; its secret lives in Supabase Auth (CAPTCHA
#   on sign-in, sign-up and password reset). The widget allows 1think2win.com, localhost and 127.0.0.1.
# CLAIM_HANDOVER_SECRET makes the 6-digit handover codes prize winners give at delivery. Optional: without it
#   the codes come from SUPABASE_SERVICE_ROLE_KEY, so rotating that key changes every code not yet used.
#   Set it once and keep it, everywhere: changing it does the same.
ADMIN_EMAILS=
ADMIN_PASSWORD=
AUTH_SECRET=
CLAIM_HANDOVER_SECRET=
CRON_SECRET=change-me-to-a-strong-random-secret
NEWSLETTER_UNSUBSCRIBE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFYus6FWoa1eqnrG

# --- EMAIL: AMAZON SES -----------------------------------------------------------------------------
# IAM user 1think2win-app, region Sydney (ap-southeast-2). Admin -> Email Services picks SES or Brevo.
# AWS_SES_SNS_TOPIC_ARN receives bounce, complaint and delivery notices (/api/webhooks/ses).
# SEND_EMAIL_HOOK_SECRET comes from Supabase -> Authentication -> Hooks -> Send Email.
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_SNS_TOPIC_ARN=
SEND_EMAIL_HOOK_SECRET=

# --- EMAIL: BREVO ----------------------------------------------------------------------------------
# Only @1think2win.com senders are verified in Brevo. BREVO_WEBHOOK_TOKEN guards /api/webhooks/brevo.
# Bravo-MCP-API-key is the old base64 key, only a fallback when BREVO_API_KEY is unset.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
BREVO_WEBHOOK_TOKEN=
Bravo-MCP-API-key=

# --- GOOGLE SIGN-IN --------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- PAYMENTS (STRIPE) -----------------------------------------------------------------------------
# Not in use yet.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- IMAGES (CLOUDINARY) ---------------------------------------------------------------------------
# Prize images and videos. The cloud name is public (it is part of every image URL).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- PUSH NOTIFICATIONS (VAPID) --------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- AI CHATBOT (GEMINI) ---------------------------------------------------------------------------
# Primary model gemini-3.5-flash (4 RPM), fallback gemini-3.1-flash-lite (14 RPM).
# Graphify_GEMINI_API_KEY is for the local Graphify tool only.
GEMINI_API_KEY=
Graphify_GEMINI_API_KEY=

# --- MATCH MODE QUESTION WORDING (GEMINI) -----------------------------------------------------------
# Its own key, so live matches never share the chatbot's quota (src/lib/match-wording.ts). Without it,
# over questions use the built-in English and Roman Urdu wording. MATCH_GEMINI_MODEL defaults to
# gemini-3.1-flash-lite. Admins review every wording before players see it, unless a match sends
# questions automatically.
# Create the key in a project with no billing account (free tier: Google refuses, never charges, past a
# limit) and not the chatbot's project: limits are per project. The app stays under the project's limits:
# requests per minute, input tokens per minute and requests per day. Copy them from AI Studio (Rate limit)
# a little lower. The defaults, 12, 200000 and 400, sit under Gemini 3.1 Flash Lite's free tier (15, 250K,
# 500); set these for another model. Over a limit, or after Google refuses one, the built-in wording is
# used until it resets (requests per day reset at midnight Pacific time).
MATCH_GEMINI_API_KEY=
MATCH_GEMINI_MODEL=
MATCH_GEMINI_RPM=
MATCH_GEMINI_TPM=
MATCH_GEMINI_RPD=

# --- ERROR TRACKING (SENTRY) -----------------------------------------------------------------------
# Off while NEXT_PUBLIC_SENTRY_DSN is empty (the DSN is public: Sentry -> Settings -> Projects -> Client Keys).
# The build reads these, so the live values go in hPanel. NEXT_PUBLIC_SENTRY_ENVIRONMENT defaults to NODE_ENV.
# SENTRY_PROJECT + SENTRY_AUTH_TOKEN (a SECRET) let the build upload source maps for readable stack traces.
# Setup: npx @sentry/wizard@latest -i nextjs --saas --org 1think2win --project 1think2winsx
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- FEATURE FLAGS ---------------------------------------------------------------------------------
# Wallet: true = players pay to enter quizzes, false = quizzes are free (the admin wallet switch can override it).
WALLET_FEATURE_ENABLED=true

# --- DATABASE URLS (Prisma era) --------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# --- OPTIONAL TUNING -----------------------------------------------------------------------------
# Visitor IP for rate limiting. Set ONE of these after measuring what your host sends:
#   curl -H "Authorization: Bearer $CRON_SECRET" -H "X-Forwarded-For: 9.9.9.9" https://YOUR-SITE/api/health?stats=1
# (step-by-step with a decision table: load-test/README.md, "Setting the visitor IP")
#  - TRUSTED_PROXY_HOPS: how many servers you control in front of the app that APPEND to
#    X-Forwarded-For (1 = one proxy, 2 = CDN + proxy). Read from the right.
#  - TRUSTED_IP_HEADER: a header the host OVERWRITES with the real visitor IP (e.g. cf-connecting-ip, x-real-ip).
# Unset = legacy behaviour (leftmost X-Forwarded-For entry, which visitors can forge).
# TRUSTED_PROXY_HOPS=1
# TRUSTED_IP_HEADER=cf-connecting-ip
# Hard timeouts (ms) for server-side Supabase calls: user-facing, and the shared service-role client
# SUPABASE_FETCH_TIMEOUT_MS=10000
# SUPABASE_ADMIN_FETCH_TIMEOUT_MS=30000
# Load shedding for /api/quizzes and /api/quizzes/[id]: answer 503 + Retry-After instead of queueing.
# 0 disables a signal. Calibrate from the load test.
# LOAD_SHED_MAX_INFLIGHT=1500
# LOAD_SHED_MAX_LAG_MS=2000
# Max simultaneous Gemini calls from the support chatbot (the API key has one shared quota)
# CHATBOT_MAX_CONCURRENT=25

# Scheduled quizzes (see docs/SCHEDULED_QUIZZES.md)
# Business timezone: used for quiz schedule times sent without a zone and for the time
# written in "upcoming quiz" notifications. Any IANA name. Default: Asia/Karachi
# NEXT_PUBLIC_APP_TIME_ZONE=Asia/Karachi
# In-process scheduler (runs scheduled quizzes/notifications every minute on a Node host).
# Default: on in production (not on Vercel), off in `next dev`. true/false to override.
# SCHEDULER_ENABLED=true
